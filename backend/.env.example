# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret & Expiration
JWT_SECRET=super_secret_employee_portal_jwt_key_987654321
JWT_EXPIRES_IN=8h

# PostgreSQL Database Connection
# Use standard connection string or separate parameters
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_portal_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=employee_portal_db

# Zoho One Integration (Credentials stored strictly in backend)
# Obtain from Zoho API Console: https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

# Zoho Application Access URLs (Configurable portal redirects)
ZOHO_PEOPLE_URL=https://people.zoho.com
ZOHO_CRM_URL=https://crm.zoho.com
ZOHO_DESK_URL=https://desk.zoho.com
ZOHO_BOOKS_URL=https://books.zoho.com

# Client / CORS URL
FRONTEND_URL=http://localhost:5173
